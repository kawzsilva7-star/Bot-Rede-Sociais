# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
# Os nomes abaixo são provisórios: confirmar na Fase 0 (ver docs/ESPECIFICACAO.md).

# Modo de teste: true = só mostra o que postaria. Troque para false depois de aprovar.
DRY_RUN=true

# Regras
COMISSAO_MINIMA_PERCENTUAL=15
# Deixe vazio para não limitar o preço.
PRECO_MAXIMO_REAIS=
DIAS_SEM_REPETIR=30
FUSO_HORARIO=America/Sao_Paulo

# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_AFFILIATE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta (Facebook e Instagram)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Opcional: descrições com a API do Claude (cobrada por uso). Deixe vazio para não usar.
ANTHROPIC_API_KEY=
